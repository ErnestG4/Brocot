{
  "name": "Spiral RLR",
  "author": "Brocot factory",
  "description": "Shared path RLRLRLR — alternating spiral. Operators on every other position trace a tight neighborhood around 1.",
  "version": "1.0",
  "category": "path canon",
  "engine": {
    "polyphony": "mono",
    "octaveShift": 0,
    "pathMode": "shared",
    "sharedPath": "RLRLRLR",
    "operators": [
      {"enabled": true,  "position": 1, "depth": 0.9},
      {"enabled": true,  "position": 3, "depth": 0.7},
      {"enabled": true,  "position": 5, "depth": 0.5},
      {"enabled": true,  "position": 7, "depth": 0.3},
      {"enabled": false, "position": 0, "depth": 0.0},
      {"enabled": false, "position": 0, "depth": 0.0},
      {"enabled": false, "position": 0, "depth": 0.0},
      {"enabled": false, "position": 0, "depth": 0.0}
    ]
  },
  "filter":   {"type": "lp", "cutoff": 0.7, "resonance": 0.1},
  "envelope": {"attack": 0.05, "decay": 0.4, "sustain": 0.8, "release": 0.6},
  "lfo":      {"shape": "sine", "rate": 0.2, "depth": 0.05, "keySync": false},
  "master":   {"level": 0.5}
}
